# Copy to .env and fill in real values before deploying.
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"

# JWT signing secret (REQUIRED in production — never use the dev default)
HOTELPRO_SECRET_KEY=replace-with-64-char-random-hex-string

# SQLite database file location (use a persistent volume in production)
HOTELPRO_DB_PATH=/app/data/hotelpro.db

# Token lifetime in hours (optional, defaults to 12)
HOTELPRO_TOKEN_TTL_HOURS=12
